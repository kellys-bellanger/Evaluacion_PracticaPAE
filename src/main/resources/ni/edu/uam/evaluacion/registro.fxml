<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="10" alignment="CENTER" prefWidth="400" prefHeight="400" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sistema.controller.RegistroController" style="-fx-padding: 20;">
    <Label text="Nueva Solicitud" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <TextField fx:id="txtNumero" promptText="Número de Solicitud"/>
    <TextField fx:id="txtCliente" promptText="Nombre del Cliente"/>
    <DatePicker fx:id="dpFecha" promptText="Fecha"/>
    <ComboBox fx:id="cmbTipo" promptText="Tipo de Solicitud"/>
    <TextField fx:id="txtDescripcion" promptText="Descripción"/>
    <ComboBox fx:id="cmbEstado" promptText="Estado"/>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Guardar" onAction="#guardar"/>
        <Button text="Cancelar" onAction="#volver"/>
    </HBox>
</VBox>